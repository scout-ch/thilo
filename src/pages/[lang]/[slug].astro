---
import SectionPage from '../../components/SectionPage.astro';
import { localizedLocales } from '../../i18n';
import { generateSectionPaths } from '../../utils/staticPaths';

export async function getStaticPaths() {
  return generateSectionPaths(localizedLocales, true);
}

const { section, locale } = Astro.props;
---

<SectionPage section={section} locale={locale} />
